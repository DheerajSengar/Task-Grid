rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. User profile avatars
    // Avatars can be read by any authenticated or public user so task cards can display team member photos
    // Only the profile owner can upload or overwrite their own avatar
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Task attachments
    // Tasks attachments can be read and written by authenticated users (including guest users)
    match /tasks/{taskId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
